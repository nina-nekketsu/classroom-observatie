# Frontend: secure mode is enabled only when all three are set.
VITE_RUNTIME_MODE=secure-sync
VITE_SYNC_ENDPOINT=/api/sync
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Private backend. Never commit real addresses or credentials.
PORT=3000
GOOGLE_CLIENT_ID=replace-with-the-same-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_TEACHER_EMAILS=teacher-one@example.test,teacher-two@example.test
SYNC_SQLITE_PATH=./data/classroom-observatie.sqlite
